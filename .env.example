# Vaultwarden secrets (DO NOT COMMIT — copy to .env locally)

# Generate with: docker run --rm -it vaultwarden/server:1.32.7 /vaultwarden hash
# In .env, replace every $ with $$ to escape docker-compose interpolation.
ADMIN_TOKEN='<argon2 PHC string with $$ escape>'

# SMTP (optional — for password reset / 2FA email codes)
SMTP_HOST=
SMTP_PORT=587
SMTP_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Vaultwarden

# Cloudflare API token — Zone:DNS:Edit + Zone:Zone:Read on bsvibe.dev
# Used by Caddy DNS-01 challenge for vault.bsvibe.dev LE cert.
CLOUDFLARE_API_TOKEN=<cf-api-token>
